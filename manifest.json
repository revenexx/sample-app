{
  "$schema": "https://revenexx.com/schemas/manifest.schema.json",
  "name": "sample-app",
  "vendor": "revenexx",
  "version": "0.3.4",
  "title": "Sample App",
  "description": "Reference scaffold for a revenexx App. A minimal hello-world function used to smoke-test the App Registry runtime end-to-end.",
  "permissions": [
    {
      "entity": "greetings",
      "access": ["read", "create", "update", "delete"]
    }
  ],
  "events": {
    "emits": [
      "sample.greeted",
      {
        "name": "greetings.created",
        "entity": "greetings",
        "on": ["insert"],
        "payload": {
          "id": "column:id",
          "name": "column:name",
          "message": "column:message",
          "locale": "column:locale"
        }
      },
      {
        "name": "greetings.updated",
        "entity": "greetings",
        "on": ["update"]
      },
      {
        "name": "greetings.deleted",
        "entity": "greetings",
        "on": ["delete"]
      }
    ],
    "listens": ["app.installed", "app.uninstalled"]
  },
  "policies": [
    {
      "name": "outbound-access",
      "attrs": {
        "host": "api.github.com",
        "path": "/zen"
      }
    },
    {
      "name": "event-publish",
      "attrs": {
        "events": [
          "sample.greeted",
          "greetings.created",
          "greetings.updated",
          "greetings.deleted"
        ]
      }
    }
  ]
}
